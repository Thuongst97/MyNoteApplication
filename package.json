{
  "name": "Premium-Note",
  "private": true,
  "version": "1.1.14",
  "description": "Premium-Note — a block-based note-taking desktop app",
  "author": "Thuong Nguyen",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "dist": "npm test && npm run build && electron-builder",
    "dist:win": "npm test && npm run build && electron-builder --win",
    "dist:mac": "npm test && npm run build && electron-builder --mac",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@tiptap/extension-code-block-lowlight": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-task-item": "^3.32.2",
    "@tiptap/extension-task-list": "^3.32.2",
    "@tiptap/extension-text-style": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/suggestion": "^3.32.2",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.20.5",
    "@types/plantuml-encoder": "^1.4.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.2",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.17",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.66.0",
    "marked": "^16.4.2",
    "mermaid": "^11.17.2",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "katex": "0.18.11",
    "lodash-es": "4.18.1"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/ia-writer-mono": "^5.3.0",
    "@fontsource/ia-writer-quattro": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@tiptap/extension-code-block": "^3.32.2",
    "@tiptap/extension-details": "^3.32.2",
    "katex": "0.18.11",
    "plantuml-encoder": "^1.4.0"
  }
}
